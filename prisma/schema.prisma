// Hidase SACCO - Prisma schema
// SQLite database for site settings, SACCO directory, membership, members, content management

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Site-wide editable settings (key/value)
model SiteSetting {
  key       String   @id
  value     String
  group     String   @default("general") // general | contact | branding | hero
  updatedAt DateTime @updatedAt
}

model MembershipApplication {
  id            String   @id @default(cuid())
  fullName      String
  email         String
  phone         String
  idNumber      String
  address       String
  city          String
  branch        String
  shareAmount   Float
  occupation    String?
  status        String   @default("pending") // pending | reviewing | approved | rejected
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([email])
  @@index([status])
}

model ContactMessage {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  subject    String
  message    String
  category   String   @default("general")
  status     String   @default("new")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([email])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sacco {
  id            String   @id @default(cuid())
  name          String
  region        String
  city          String
  type          String
  established   Int?
  members       Int?
  assetsBirr    Float?
  phone         String?
  email         String?
  website       String?
  services      String
  description   String
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([region])
  @@index([type])
  @@index([featured])
}

model LoanApplication {
  id            String   @id @default(cuid())
  fullName      String
  email         String
  phone         String
  loanType      String
  amount        Float
  termMonths    Int
  monthlyIncome Float?
  status        String   @default("pending")
  memberId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  member        Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
}

// ---------------------------------------------------------------------------
// MEMBER ACCOUNTS (login + dashboard)
// ---------------------------------------------------------------------------
model Member {
  id                 String   @id @default(cuid())
  memberNumber       String   @unique
  fullName           String
  email              String   @unique
  passwordHash       String
  phone              String?
  city               String?
  branch             String?
  occupation         String?
  idType             String?
  idNumber           String?
  sex                String?
  education          String?
  maritalStatus      String?
  compulsorySavings  Float    @default(0)
  voluntarySavings   Float    @default(0)
  childSavings       Float    @default(0)
  timeDeposit        Float    @default(0)
  shareCount         Int      @default(0)
  status             String   @default("active") // active | suspended | closed
  joinedAt           DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  transactions      MemberTransaction[]
  loans             MemberLoan[]
  loanApplications   LoanApplication[]

  @@index([status])
}

model MemberTransaction {
  id          String   @id @default(cuid())
  memberId    String
  type        String   // deposit | withdrawal | interest | dividend | loan_disbursement | loan_payment | fee | salary
  amount      Float
  balance     Float    @default(0)
  description String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([type])
}

model MemberLoan {
  id             String   @id @default(cuid())
  memberId       String
  loanType       String
  principal      Float
  remaining      Float
  rate           Float
  termMonths     Int
  monthlyPayment Float
  paidMonths     Int      @default(0)
  status         String   @default("active") // active | closed | defaulted
  startDate      DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  member         Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// CONTENT MANAGEMENT (admin-editable marketing content)
// ---------------------------------------------------------------------------
model NavItem {
  id        String   @id @default(cuid())
  label     String
  href      String   @default("#")
  slug      String?
  parentId  String?
  group     String?
  icon      String?
  order     Int      @default(0)
  visible   Boolean  @default(true)
  openInNew Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@index([parentId])
}

model NewsItem {
  id        String   @id @default(cuid())
  title     String
  date      String
  excerpt   String
  tag       String   @default("Update")
  icon      String   @default("Globe")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

model EventItem {
  id          String   @id @default(cuid())
  day         String
  month       String
  dayName     String
  title       String
  time        String
  location    String
  type        String   @default("Event")
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContentImage {
  id        String   @id @default(cuid())
  section   String   // hero | partners | gallery | about
  key       String   @unique
  url       String   // URL or base64 data URL
  alt       String?
  updatedAt DateTime @updatedAt

  @@index([section])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  quote     String
  initials  String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Job postings + applications
model Job {
  id          String   @id @default(cuid())
  title       String
  department  String   @default("Operations")
  type        String   @default("Full-time") // Full-time | Part-time | Contract | Internship
  location    String   @default("Addis Ababa")
  description String
  requirements String?
  salary      String?
  closingDate DateTime?
  status      String   @default("open") // open | closed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  applications JobApplication[]

  @@index([status])
}

model JobApplication {
  id          String   @id @default(cuid())
  jobId       String
  fullName    String
  email       String
  phone       String?
  education   String?
  experience  String?
  coverLetter String?
  cvFileName  String?
  cvUrl       String?
  status      String   @default("new") // new | reviewed | interview | offered | rejected
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
  @@index([email])
}

// Dedicated content pages (CMS) — each sub-menu item links to ?page=slug
model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  subtitle  String?
  content   String   @default("")
  section   String   @default("about") // about | services | loans | members | resources | contact
  icon      String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section])
  @@index([published])
}
