# ═══════════════════════════════════════════════════════════════════════════════
# Zelaki Sacco — Environment Variables Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is already in .gitignore.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev:
#   DATABASE_URL=file:./db/custom.db
# Production on cPanel (use the absolute path under your cPanel home):
#   DATABASE_URL=file:/home/YOUR_CPANEL_USER/zelaki-sacco/db/custom.db
DATABASE_URL=file:./db/custom.db

# ── NextAuth ──────────────────────────────────────────────────────────────────
# The canonical public URL of your site. No trailing slash.
# Local dev:  http://localhost:3000
# Production: https://yourdomain.com
NEXTAUTH_URL=http://localhost:3000

# Random secret used to sign/encrypt session tokens.
# Generate one with: openssl rand -base64 32
# REQUIRED in production — the app will error without it.
NEXTAUTH_SECRET=REPLACE_WITH_32_CHAR_RANDOM_SECRET

# ── App ───────────────────────────────────────────────────────────────────────
# Set to "production" on cPanel; "development" locally.
NODE_ENV=development

# Port the Next.js server listens on.
# On cPanel, set this to the port shown in the Node.js App panel.
PORT=3000
